//----------------------------------------------
Behavior=BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  condition = RETURN = true
  condition = DEPLOY = true
  perpetual = true
  updates   = RETURN_UPDATE
  endflag   = RETURN = false
  endflag   = DEPLOY = false
  endflag   = MISSION = complete
	
           speed = 2.5
  capture_radius = 2.0
     slip_radius = 8.0
          points = 0, 0
 }

//----------------------------------------------
Behavior=BHV_ConstantSpeed
{
  name      = const_speed
  pwt       = 200
  condition = SPD=true
  condition = DEPLOY = true
  perpetual = true
  updates   = SPEED_UPDATE
  endflag   = SPD = false

           speed = 0.5
		    duration = 10
	duration_reset = CONST_SPD_RESET=true
	
}

// Bravo loiter behavior
Behavior=BHV_Loiter
{
  name      = east_loiter
  pwt       = 150
  condition = RETURN = false
  condition = DEPLOY = true
  condition = LOITER_REGION = east
  perpetual = true
  updates   = LOITER_UPDATE
  endflag   = LOITER_REGION = west
  duration = 150
  duration_idle_decay = false

  use_alt_speed = true
  speed_alt = 2.5
  radius = 10.0
  clockwise = false
  polygon = format=radial, x=160, y=-50, radius=30, pts=8, snap=1, label=Lima

}

Behavior=BHV_Loiter
{
  name      = west_loiter
  pwt       = 150
  condition = RETURN = false
  condition = DEPLOY = true
  condition = LOITER_REGION = west
  perpetual = true
  updates   = LOITER_WEST_UPDATE
  endflag   = LOITER_REGION = east
  duration = 150
  duration_idle_decay = false

  use_alt_speed = true
  speed_alt = 2.5
  radius = 10.0
  clockwise = true
  polygon = format=radial, x=100, y=-75, radius=30, pts=8, snap=1, label=Lima
}

// The Bravo UUV Mission (Assignment 6.3)
Behavior=BHV_ConstantDepth
{
  name      = east_depth
  pwt       = 300
  condition = DEPLOY = true
  condition = LOITER_REGION = east
  perpetual = true
  updates   = EAST_DEPTH_UPDATE
  duration  = no-time-limit

           depth = 10.0
}

Behavior=BHV_ConstantDepth
{
  name      = west_depth
  pwt       = 300
  condition = DEPLOY = true
  condition = LOITER_REGION = west
  perpetual = true
  updates   = WEST_DEPTH_UPDATE
  duration  = no-time-limit

           depth = 30.0
}

// The Bravo UUV Mission (Assignment 6.4)
Behavior=BHV_Timer
{
  name      = underwater_timer
  pwt       = 50
  perpetual = true
  condition = GPS_RELOCATION = false
  duration_reset = GPS_RELOCATION = false
  duration_idle_decay = false
  runflag   = DEPLOY = true
  endflag   = DEPLOY = false
  endflag   = GPS_RELOCATION = true

  duration = 200.0
}

Behavior=BHV_Timer
{
  name      = surface_timer
  pwt       = 50
  perpetual = true
  condition = GPS_RELOCATION = true
  condition  = NAV_DEPTH < 0.1
  duration_reset = GPS_RELOCATION = true
  duration_idle_decay = false
  runflag   = DEPLOY = false
  endflag   = DEPLOY = true
  endflag   = GPS_RELOCATION = false

  duration = 60.0
}

Behavior=BHV_ConstantDepth
{
  name      = gps_relocate_depth
  pwt       = 300
  condition = DEPLOY = false
  condition = GPS_RELOCATION = true
  perpetual = true
  updates   = GPS_RELOCATE_DEPTH_UPDATE
  duration  = no-time-limit

           depth = 0.0
}