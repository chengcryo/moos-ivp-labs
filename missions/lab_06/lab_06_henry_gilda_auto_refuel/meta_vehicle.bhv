//-----------------------------------------------
// Helm Behavior file 

initialize   DEPLOY  = true
initialize   RETURN  = false
initialize   STATION_KEEP = false
initialize   LOITER  = true
initialize   REFUEL_NEEDED = false

set MODE = ACTIVE {
  DEPLOY = true
} INACTIVE

set MODE = STATION-KEEPING {
  MODE = ACTIVE
  STATION_KEEP = true
} NON-STATION-KEEPING

set MODE = LOITERING {
  MODE = ACTIVE:NON-STATION-KEEPING
  LOITER = true
}

set MODE = RETURNING {
  MODE = ACTIVE:NON-STATION-KEEPING
  RETURN = true
}

set MODE = REFUELING {
  MODE = ACTIVE:NON-STATION-KEEPING
  REFUEL_NEEDED = true
}

//----------------------------------------------
Behavior = BHV_Loiter
{
  name      = loiter
  pwt       = 100
  condition = MODE==LOITERING

   post_suffix = A
         speed = 1.3
     clockwise = false
        radius = 8.0
     nm_radius = 15.0
       polygon = radial::$(LOITER_POS), radius=20, pts=8, snap=1, label=$(VNAME)_LOITER

  visual_hints = nextpt_color=white, nextpt_lcolor=khaki
  visual_hints = edge_color=orange, vertex_color=white
  visual_hints = edge_size=1, vertex_size=2
}


//----------------------------------------------
Behavior = BHV_Waypoint
{
  name      = waypt_return
  pwt       = 100
  condition = MODE==RETURNING
  endflag   = RETURN = false
  perpetual = true

      speed = 1.3
     radius = 3.0
  nm_radius = 15.0
     points = start
       lead = 8
}

//----------------------------------------------
Behavior = BHV_StationKeep
{
  name      = station-keep
  pwt       = 100
  condition = MODE==STATION-KEEPING

  center_activate = true
     inner_radius = 5
     outer_radius = 10 
      outer_speed = 1.0
    transit_speed = 1.3
       swing_time = 7
     visual_hints = vertex_size=0, edge_color=gray50
}

Behavior = BHV_Timer
{
  name      = refuel
  pwt       = 100
  condition = MODE==REFUELING
  duration  = 60
  duration_reset = true
  duration_idle_decay = false
  perpetual = true

  endflag   = DEPLOY = true
  endflag   = LOITER = true
  endflag   = REFUEL_NEEDED = false
  endflag   = STATION_KEEP = false
}

Behavior = BHV_Timer
{
  name                = return_to_refuel
  pwt                 = 100
  condition           = MODE==LOITERING
  duration            = 300
  duration_idle_decay = false
  perpetual           = true

  endflag             = RETURN = true
  endflag             = REFUEL_NEEDED = true
  endflag             = LOITER = false
  endflag             = STATION_KEEP = false
}